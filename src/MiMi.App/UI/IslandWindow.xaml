<Window x:Class="MiMi.App.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MiMi.App.UI"
        xmlns:mascot="clr-namespace:MiMi.App.UI.Mascot"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="MiMi"
        Width="960" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Arrow">

    <Window.Resources>
        <!-- ============================= palette ============================= -->
        <SolidColorBrush x:Key="Surface" Color="#F0141416"/>
        <SolidColorBrush x:Key="Stroke" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F2F4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#C0FFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#86FFFFFF"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFB454"/>
        <SolidColorBrush x:Key="AccentInk" Color="#FF1A1A1C"/>
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#FF2A2A2E"/>
        <SolidColorBrush x:Key="EqBar" Color="#CCFFFFFF"/>

        <!-- Typography ladder (DynamicResource so the Small/Default/Large setting
             updates live). Sizes are modest step-ups from the previous scale. -->
        <sys:Double x:Key="FontMicro">11</sys:Double>
        <sys:Double x:Key="FontCaption">12</sys:Double>
        <sys:Double x:Key="FontBody">13</sys:Double>
        <sys:Double x:Key="FontPrimary">14</sys:Double>
        <sys:Double x:Key="FontTitle">15.5</sys:Double>
        <sys:Double x:Key="FontMono">12</sys:Double>

        <DropShadowEffect x:Key="PillShadow" BlurRadius="34" ShadowDepth="1" Direction="270"
                          Opacity="0.55" Color="#C8000000"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:StringToVisibilityConverter x:Key="StringToVis"/>
        <ui:PendingCountToVisibilityConverter x:Key="PendingToVis"/>

        <Style x:Key="IslandFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonoFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontMono}"/>
        </Style>

        <!-- ============================ buttons ============================ -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Command" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApproveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{StaticResource AccentAmber}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFC36A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE09B3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Command" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ slider ============================ -->
        <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="18">
                            <Border Background="{TemplateBinding Background}"
                                    Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Height="18">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}"
                                                  Command="Slider.DecreaseLarge"
                                                  Background="{StaticResource TextSecondary}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}"
                                                  Command="Slider.IncreaseLarge"
                                                  Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFFFF" Stroke="#66000000" StrokeThickness="0.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ templates ============================ -->
        <DataTemplate DataType="{x:Type ui:RestingView}">
            <!-- Face-only idle per the approved reference: the mascot is the entire
                 content — no clock, no status text, nothing else. -->
            <mascot:MiMiMascotControl Width="56" Height="26" Expression="{Binding Expression}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding ShowMascot, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:MediaCompactView}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource ArtPlaceholder}">
                    <Image Source="{Binding Media.Art}" Stretch="UniformToFill" Width="28" Height="28"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="200">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold"
                               Text="{Binding Media.Title}" ToolTip="{Binding Media.Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{Binding Media.Subtitle}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Media.Subtitle, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
                <StackPanel x:Name="Eq" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                    <Rectangle Width="2.5" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EqBar}"
                               Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1" Fill="{StaticResource EqBar}"
                               Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="8" RadiusX="1" RadiusY="1" Fill="{StaticResource EqBar}"
                               Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
                <!-- Tiny agent-count badge: both worlds stay discoverable while music plays. -->
                <Border Background="#22FFB454" CornerRadius="9" Padding="6,2" Margin="4,0,2,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasAgentBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAmber}"
                               Text="{Binding AgentBadgeLabel, Mode=OneWay}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:MediaExpandedView}">
            <StackPanel Margin="20,14,20,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="58" Height="58" CornerRadius="12" Background="{StaticResource ArtPlaceholder}">
                        <Image Source="{Binding Media.Art}" Stretch="UniformToFill" Width="58" Height="58"/>
                    </Border>
                    <Grid Margin="14,0,0,0" Width="300" VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding Media.LyricsBlockVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextTertiary}"
                                       Text="{Binding Media.LyricPrev}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,2,0,2">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding Media.LyricCurrentColor}"/>
                                </TextBlock.Foreground>
                                <Run Text="{Binding Media.LyricCurrent, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding Media.LyricNext}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Media.LyricsBlockHidden, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding Media.Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding Media.Subtitle}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Media.Subtitle, Converter={StaticResource StringToVis}}"/>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="10.5"
                                       Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"
                                       Text="{Binding Media.Source}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Slider x:Name="ProgressSlider" Style="{StaticResource IslandSlider}" Margin="0,12,0,0"/>
                <Grid Margin="0,3,0,0">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextSecondary}" Text="{Binding Media.Elapsed}"
                               HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextSecondary}" Text="{Binding Media.Remaining}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="LyricsToggle" Style="{StaticResource TransportButton}" FontSize="12"
                            Width="30" Height="30" Margin="0,0,12,0"
                            Content="&#xE7C3;" ToolTip="Toggle synchronized lyrics"/>
                    <mascot:MiMiMascotControl Width="26" Height="17" Expression="Lively"
                                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding Media.PreviousCommand}"
                            Content="&#xE892;"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}" FontSize="17"
                            Width="40" Height="40" Margin="10,0"
                            Command="{Binding Media.PlayPauseCommand}">
                        <TextBlock x:Name="PlayPauseGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE769;"/>
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding Media.NextCommand}"
                            Content="&#xE893;"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentCompactView}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <mascot:MiMiMascotControl Width="18" Height="12" Margin="2,0,0,0"
                                          Expression="{Binding Indicator.Expression}"
                                          VerticalAlignment="Center"/>
                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center" Width="240">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold"
                               Text="{Binding Indicator.Line}" ToolTip="{Binding Indicator.Line}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource AccentAmber}"
                               Text="{Binding Indicator.PendingLabel}"
                               Visibility="{Binding Indicator.PendingLabel, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentExpandedView}">
            <StackPanel Margin="20,14,20,12">
                <StackPanel Orientation="Horizontal">
                    <mascot:MiMiMascotControl Width="20" Height="14" Expression="{Binding Agent.Expression}"
                                              VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontPrimary}" FontWeight="SemiBold"
                               Margin="9,0,0,0" Text="{Binding Agent.Provider}"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                               Foreground="{StaticResource TextTertiary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.ProjectLabel}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Agent.ProjectLabel, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}" Margin="0,10,0,0"
                           VerticalAlignment="Top"
                           Text="{Binding Agent.Title}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}" Text="{Binding Agent.Message}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.Message, Converter={StaticResource StringToVis}}"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}" Margin="0,6,0,0"
                           Foreground="{StaticResource TextTertiary}" Text="{Binding Agent.SessionLabel}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.SessionLabel, Converter={StaticResource StringToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ApprovalView}">
            <StackPanel Margin="18,13,18,12">
                <StackPanel Orientation="Horizontal">
                    <mascot:MiMiMascotControl Width="22" Height="15" Expression="Alert"
                                              VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontPrimary}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAmber}" Margin="9,0,0,0"
                               Text="{Binding Agent.Title}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                               Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.Provider}"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextTertiary}" Margin="8,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.TimeLeft}"
                               Visibility="{Binding Agent.TimeLeft, Converter={StaticResource StringToVis}}"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource AccentAmber}" Margin="8,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.ApprovalPosition}"/>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                                Visibility="{Binding Agent.HasMultipleApprovals, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource TransportButton}" Width="24" Height="24"
                                FontSize="{DynamicResource FontMicro}"
                                AutomationProperties.Name="Previous approval"
                                ToolTip="Previous approval"
                                Command="{Binding Agent.PrevApprovalCommand}" Content="&#xE76B;"/>
                        <Button Style="{StaticResource TransportButton}" Width="24" Height="24"
                                FontSize="{DynamicResource FontMicro}"
                                AutomationProperties.Name="Next approval"
                                ToolTip="Next approval"
                                Command="{Binding Agent.NextApprovalCommand}" Content="&#xE76C;"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="1,9,0,0"
                           Text="{Binding Agent.Message}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.Message, Converter={StaticResource StringToVis}}"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="1,0,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text="{Binding Agent.ProjectLabel}"
                           Visibility="{Binding Agent.ProjectLabel, Converter={StaticResource StringToVis}}"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="1,0,0,0"
                           Text="{Binding Agent.ActionLabel}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.ActionLabel, Converter={StaticResource StringToVis}}"/>

                <Border Background="#1AFFFFFF" CornerRadius="7" Padding="10,6" Margin="1,8,0,0"
                        HorizontalAlignment="Left" MaxWidth="400"
                        Visibility="{Binding Agent.Command, Converter={StaticResource StringToVis}}">
                    <TextBlock Style="{StaticResource MonoFont}" Text="{Binding Agent.Command}"
                               ToolTip="{Binding Agent.Command}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="1,11,0,0">
                    <Button Style="{StaticResource ApproveButton}" Command="{Binding Agent.ApproveCommand}"
                            AutomationProperties.Name="Approve request"
                            ToolTip="Approve this request"
                            Content="Approve"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Agent.DenyCommand}"
                            AutomationProperties.Name="Deny request"
                            ToolTip="Deny this request"
                            Content="Deny" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Agent.OpenCommand}"
                            AutomationProperties.Name="Open in agent"
                            ToolTip="Copy a safe session reference to the clipboard"
                            Content="Open in Agent" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentActivityPanelView}">
            <StackPanel Margin="20,14,20,12">
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontPrimary}" FontWeight="SemiBold"
                           Text="Agent activity"/>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,9">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding StateBrush.Color}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Width="118" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"
                                                   Text="{Binding Provider}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   Text="{Binding Project}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Width="150">
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                                                   Text="{Binding StatusLabel}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Text="{Binding LastAction}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   Text="{Binding AgeLabel}" HorizontalAlignment="Right"/>
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource AccentAmber}"
                                                   Text="{Binding PendingApprovals, StringFormat='{}{0} pending'}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Confirmed events only; bounded to three newest entries. -->
                                <ItemsControl ItemsSource="{Binding Timeline}" Margin="16,2,0,0"
                                              Visibility="{Binding Timeline.Count, Converter={StaticResource PendingToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                           Foreground="{StaticResource TextTertiary}"
                                                           Text="{Binding TimeLabel}" Width="38"/>
                                                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                           Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0"
                                                           Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <!-- Pill anchored top-center; the window is a large transparent canvas whose only
         hit-testable region is the pill itself (Background={x:Null} above). -->
    <Grid>
        <Border x:Name="Pill" Width="150" Height="36" CornerRadius="18"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0.5"
                Effect="{StaticResource PillShadow}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Cursor="Arrow">
            <Grid>
                <!-- MiMi's signature warmth now lives INSIDE the island, like Nusa's
                     aurora: warm gold pooling under the face rather than leaking out
                     beneath the pill. The opacity is driven by expression in code. -->
                <Grid x:Name="GlowRoot" IsHitTestVisible="False" Panel.ZIndex="0">
                    <!-- Ellipses, not a rounded rectangle: the light should fade like an
                         aurora with no visible inner edge. Inset so it never touches the
                         pill's border. -->
                    <Ellipse x:Name="GlowPool" Stretch="Fill" Margin="7,2,7,2">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62"
                                                 RadiusX="0.58" RadiusY="0.72">
                                <GradientStop Color="#59F5B84B" Offset="0"/>
                                <GradientStop Color="#2BEAA63A" Offset="0.55"/>
                                <GradientStop Color="#00D99B35" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- A brighter core glows behind the face without reaching the edge. -->
                    <Ellipse x:Name="GlowCore" Stretch="Fill" Margin="26,5,26,5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.52" GradientOrigin="0.5,0.52"
                                                 RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#59F7C264" Offset="0"/>
                                <GradientStop Color="#00D99B35" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <!-- Ambient top sheen: the premium dark-surface cue. Clipped to the pill. -->
                <Border IsHitTestVisible="False" Panel.ZIndex="0" VerticalAlignment="Top" Height="24"
                        CornerRadius="17,17,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0BFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <ContentControl x:Name="Host" Focusable="False" IsHitTestVisible="True" Panel.ZIndex="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
