                                         Background="#2EFFFFFF" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,5,0,0"
                                         Visibility="{Binding Widgets.BatteryProgress, Converter={StaticResource NullToCollapsed}}"/>
