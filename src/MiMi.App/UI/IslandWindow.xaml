                </UniformGrid>
                <Border Background="#10FFFFFF" CornerRadius="13" Padding="8,5" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Widgets.WeekDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
