        <DataTemplate DataType="{x:Type ui:ClipboardView}">
            <StackPanel Margin="18,14,18,14">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource TransportButton}" Width="26" Height="26" Margin="0,0,9,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseUtilityCommand}"
                            ToolTip="Back to island">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Text="&#xE72B;"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PanelHeading}" Text="Clipboard"/>
                        <TextBlock Style="{StaticResource PanelHint}" Text="{Binding Clipboard.StatusLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                                Command="{Binding Clipboard.CaptureNowCommand}" ToolTip="Capture the current text clipboard">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE77B;"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                                Command="{Binding Clipboard.ClearCommand}" IsEnabled="{Binding Clipboard.HasEntries}"
                                ToolTip="Clear all remembered clips">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE74D;"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5"
                                Command="{Binding Clipboard.ToggleCaptureCommand}" ToolTip="Turn automatic clipboard capture on or off"
                                Content="{Binding Clipboard.CaptureLabel}"/>
                    </StackPanel>
                </Grid>
                <Border Background="#10FFFFFF" CornerRadius="12" Padding="10,7" Margin="0,0,0,9">
                    <TextBlock Style="{StaticResource PanelHint}"
                               Text="Text only · kept in memory until MiMi exits · never written to disk or logs."/>
                </Border>
                <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Clipboard.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ClipboardRow" Tag="{Binding Text}" Background="#14FFFFFF"
                                        BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="11"
                                        Padding="9,7" Margin="0,0,0,6" Cursor="SizeAll"
                                        ToolTip="Drag into an app to paste, or click Copy">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                                                       Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource IslandFont}" FontSize="10"
                                                       Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"
                                                       Text="{Binding TimeLabel}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TransportButton}" Width="26" Height="26"
                                                    Command="{Binding CopyCommand}" ToolTip="Copy this clip again">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE8C8;"/>
                                            </Button>
                                            <Button Style="{StaticResource TransportButton}" Width="26" Height="26" Margin="5,0,0,0"
                                                    Command="{Binding RemoveCommand}" ToolTip="Forget this clip">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Text="&#xE711;"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource PanelHint}" Margin="0,7,0,0"
                           Text="Copy something to add it here, or use Capture now."
                           Visibility="{Binding Clipboard.HasEntries, Converter={StaticResource InverseBoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:WidgetsView}">
