    <!-- Pill anchored top-center; the window is a large transparent canvas whose only
         hit-testable region is the pill itself (Background={x:Null} above). -->
    <Grid>
        <Border x:Name="Pill" Width="150" Height="36" CornerRadius="18"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource AuroraBorderBrush}" BorderThickness="1"
                Effect="{StaticResource PillShadow}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Cursor="Arrow">
            <Grid>
                <Grid x:Name="GlowRoot" IsHitTestVisible="False" Panel.ZIndex="0">
                    <!-- Warm gold aurora hugging the inside bottom edge. Height stays fixed
                         in DIPs so expanded panels never grow an oversized center oval. -->
                    <Grid x:Name="GlowBand" Height="8" VerticalAlignment="Bottom" Margin="0,0,0,0">
                        <!-- Wide flat arc: strongest bottom-center, fading toward corners. -->
                        <Ellipse Stretch="Fill">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.6"
                                                     RadiusX="0.5" RadiusY="0.55">
                                    <GradientStop Color="#73F5B84B" Offset="0"/>
                                    <GradientStop Color="#2BEA963A" Offset="0.55"/>
                                    <GradientStop Color="#00D98B35" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Thin luminous rim right at the boundary. -->
                        <Rectangle Height="1.5" VerticalAlignment="Bottom" RadiusX="0.75" RadiusY="0.75">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="#4DF7C264"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>
                <!-- Ambient top sheen: the premium dark-surface cue. Clipped to the pill. -->
                <Border IsHitTestVisible="False" Panel.ZIndex="0" VerticalAlignment="Top" Height="24"
                        CornerRadius="17,17,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0BFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <ContentControl x:Name="Host" Focusable="False" IsHitTestVisible="True" Panel.ZIndex="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
