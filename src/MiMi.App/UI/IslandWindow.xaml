                                        <TextBlock Style="{StaticResource IslandFont}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DayNumber}"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource WidgetLabel}" HorizontalAlignment="Center"
