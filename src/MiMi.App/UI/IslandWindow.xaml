<Window x:Class="MiMi.App.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MiMi.App.UI"
        xmlns:mascot="clr-namespace:MiMi.App.UI.Mascot"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="MiMi"
        Width="960" Height="560" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Cursor="Arrow"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ============================= palette ============================= -->
        <SolidColorBrush x:Key="Surface" Color="#FF05060C"/>
        <SolidColorBrush x:Key="Stroke" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F2F4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#C0FFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFFFB45C"/>
        <SolidColorBrush x:Key="AccentGoldLight" Color="#FFFFE2AE"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFFFC266"/>
        <SolidColorBrush x:Key="AccentCopper" Color="#FFFF9861"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF69E3A6"/>
        <SolidColorBrush x:Key="AccentPink" Color="#FFFF8FC7"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFFC06A"/>
        <SolidColorBrush x:Key="AccentInk" Color="#FF05060C"/>
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#FF1A1712"/>
        <SolidColorBrush x:Key="EqBar" Color="#CCFFFFFF"/>
        <LinearGradientBrush x:Key="AuroraBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFE6B0" Offset="0"/>
            <GradientStop Color="#FFFFC266" Offset="0.52"/>
            <GradientStop Color="#FFFF9257" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AuroraBorderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#99FFE6B0" Offset="0"/>
            <GradientStop Color="#66FFC266" Offset="0.52"/>
            <GradientStop Color="#99FF9257" Offset="1"/>
        </LinearGradientBrush>
        <!-- Caret brush: the island never shows a text caret. Without this, WPF paints the
             system caret (an "A" with a "^" above it) on the first focusable text surface,
             which reads as a stray glyph sitting on top of the face. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Transparent"/>

        <!-- Typography ladder (DynamicResource so the Small/Default/Large setting
             updates live). Sizes are modest step-ups from the previous scale. -->
        <sys:Double x:Key="FontMicro">12</sys:Double>
        <sys:Double x:Key="FontCaption">13</sys:Double>
        <sys:Double x:Key="FontBody">14</sys:Double>
        <sys:Double x:Key="FontPrimary">15</sys:Double>
        <sys:Double x:Key="FontTitle">16.5</sys:Double>
        <sys:Double x:Key="FontMono">13</sys:Double>

        <DropShadowEffect x:Key="PillShadow" BlurRadius="34" ShadowDepth="1" Direction="270"
                          Opacity="0.55" Color="#C8000000"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:StringToVisibilityConverter x:Key="StringToVis"/>
        <ui:PendingCountToVisibilityConverter x:Key="PendingToVis"/>
        <ui:RunningToGlyphConverter x:Key="RunningToGlyph"/>
        <ui:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="IslandScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Margin="2,0">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#55FFFFFF" CornerRadius="2"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every label in the island derives from IslandText, so rounding and hinting
             settings are applied once and cannot drift between templates. -->
        <!-- Rendering hygiene for every label in the island.
             UseLayoutRounding + ClearType keep glyphs on whole pixels (no half-pixel
             smearing), and fixed hinting keeps a label's glyphs identical between frames,
             so text no longer looks jumbled while a panel is resizing. -->
        <Style x:Key="IslandText" TargetType="TextBlock">
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="IslandFont" TargetType="TextBlock" BasedOn="{StaticResource IslandText}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonoFont" TargetType="TextBlock" BasedOn="{StaticResource IslandText}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontMono}"/>
        </Style>

        <Style x:Key="PanelHeading" TargetType="TextBlock" BasedOn="{StaticResource IslandFont}">
            <Setter Property="FontSize" Value="{DynamicResource FontPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PanelHint" TargetType="TextBlock" BasedOn="{StaticResource IslandFont}">
            <Setter Property="FontSize" Value="{DynamicResource FontMicro}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Keep the overlay non-activating; describe icon-only actions to assistive tools. -->
        <Style x:Key="IslandFocusCue" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border BorderBrush="{StaticResource AccentAmber}" BorderThickness="1"
                                CornerRadius="8" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentAmber}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusCue}"/>
            <Setter Property="ToolTip" Value="Type a task, then press Enter or Add"/>
        </Style>

        <!-- ============================ buttons ============================ -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FontCaption}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusCue}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Command" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickAccessTile" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetCard" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="WidgetValue" TargetType="TextBlock" BasedOn="{StaticResource IslandFont}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="WidgetLabel" TargetType="TextBlock" BasedOn="{StaticResource IslandFont}">
            <Setter Property="FontSize" Value="{DynamicResource FontMicro}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ApproveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{StaticResource AccentAmber}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFC36A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE09B3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusCue}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Command" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="17"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentAmber}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LyricLineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusCue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ slider ============================ -->
        <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="18">
                            <Border Background="{TemplateBinding Background}"
                                    Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusCue}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Height="18">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}"
                                                  Command="Slider.DecreaseLarge"
                                                  Background="{StaticResource TextSecondary}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}"
                                                  Command="Slider.IncreaseLarge"
                                                  Background="#30FFFFFF"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFFFF" Stroke="#66000000" StrokeThickness="0.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ templates ============================ -->
        <DataTemplate DataType="{x:Type ui:RestingView}">
            <!-- Face-only idle per the approved reference: the mascot is the entire
                 content — no clock, no status text, nothing else. -->
            <!-- The whole pill is the click target (the face alone is a small hit area),
                 so the host fills the content box and paints a transparent background.
                 The face keeps its aspect ratio (the mascot's own Viewbox) and is never
                 squashed or clipped by the pill's rounded clip. -->
            <Grid x:Name="IdleFaceHost" Background="Transparent" IsHitTestVisible="True" Cursor="Hand"
                  ToolTip="Open Quick Access"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <mascot:MiMiMascotControl Width="64" Height="28" Expression="{Binding Expression}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding ShowMascot, Converter={StaticResource BoolToVis}}"/>
                <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource AccentAmber}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMascot}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Border Background="#22F5B84B" CornerRadius="9" Padding="5,2"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                        Visibility="{Binding ShelfCount, Converter={StaticResource PendingToVis}}"
                        ToolTip="Files on the shelf">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource AccentAmber}" Text="&#xE8B7;"/>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                   Foreground="{StaticResource AccentAmber}" Margin="4,0,0,0" Text="{Binding ShelfCount}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:MediaCompactView}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonDown="CompactMedia_Click">
                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource ArtPlaceholder}">
                    <Image Source="{Binding Media.Art}" Stretch="UniformToFill" Width="28" Height="28"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="200">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold"
                               Text="{Binding Media.Title}" ToolTip="{Binding Media.Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{Binding Media.Subtitle}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Media.Subtitle, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
                <StackPanel x:Name="Eq" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                    <Rectangle Width="2.5" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EqBar}"
                               Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1" Fill="{StaticResource EqBar}"
                               Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="8" RadiusX="1" RadiusY="1" Fill="{StaticResource EqBar}"
                               Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
                <!-- Tiny agent-count badge: both worlds stay discoverable while music plays. -->
                <Border Background="#22FFB454" CornerRadius="9" Padding="6,2" Margin="4,0,2,0"
                        VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="AgentBadge_Click"
                        ToolTip="Open agent activity"
                        Visibility="{Binding HasAgentBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAmber}"
                               Text="{Binding AgentBadgeLabel, Mode=OneWay}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:MediaExpandedView}">
            <StackPanel Margin="20,14,20,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="58" Height="58" CornerRadius="12" Background="{StaticResource ArtPlaceholder}">
                        <Grid>
                        <Image Source="{Binding Media.Art}" Stretch="UniformToFill" Width="58" Height="58"/>
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                               Foreground="{StaticResource TextTertiary}" Text="&#xE8D6;"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Media.Art}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Margin="14,0,0,0" Width="300" VerticalAlignment="Center"
                                              ToolTip="{Binding Media.Title}">
                        <StackPanel Visibility="{Binding Media.LyricsBlockVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextTertiary}"
                                       Text="{Binding Media.LyricPrev}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                       MouseLeftButtonDown="CurrentLyric_Click" AutomationProperties.Name="Jump to the current lyric"
                                       Margin="0,2,0,2" TextTrimming="CharacterEllipsis" ToolTip="Click to jump to this lyric">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding Media.LyricCurrentColor}"/>
                                </TextBlock.Foreground>
                                <Run Text="{Binding Media.LyricCurrent, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding Media.LyricNext}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Media.LyricsBlockHidden, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding Media.Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding Media.Subtitle}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Media.Subtitle, Converter={StaticResource StringToVis}}"/>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="10.5"
                                       Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"
                                       Text="{Binding Media.Source}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Slider x:Name="ProgressSlider" Style="{StaticResource IslandSlider}" Margin="0,10,0,0"
                                        AutomationProperties.Name="Playback position" ToolTip="Seek in the current track"/>
                <Grid Margin="0,3,0,0">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextSecondary}" Text="{Binding Media.Elapsed}"
                               HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextSecondary}" Text="{Binding Media.Remaining}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Style="{StaticResource TransportButton}" Width="30" Height="30" Margin="0,0,12,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OpenQuickAccessCommand}"
                            Content="&#xE7C4;" ToolTip="Open Quick Access"/>
                    <Button x:Name="LyricsToggle" Style="{StaticResource TransportButton}" FontSize="12"
                            Width="30" Height="30" Margin="0,0,12,0"
                            Content="&#xE7C3;" ToolTip="Toggle synchronized lyrics"/>
                    <mascot:MiMiMascotControl Width="26" Height="17" Expression="Lively"
                                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding Media.PreviousCommand}"
                            Content="&#xE892;" ToolTip="Previous track"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}" FontSize="17"
                            Width="40" Height="40" Margin="10,0"
                            Command="{Binding Media.PlayPauseCommand}" ToolTip="Play or pause">
                        <TextBlock x:Name="PlayPauseGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE769;"/>
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding Media.NextCommand}"
                            Content="&#xE893;" ToolTip="Next track"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentCompactView}">
            <Grid x:Name="AgentCompactHost" Margin="18,0" VerticalAlignment="Center" Cursor="Hand"
                  Background="Transparent" ToolTip="Open agent activity and options"
                  MouseLeftButtonDown="CompactAgent_Click">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="42" Height="28" Stretch="Uniform" VerticalAlignment="Center">
                    <mascot:MiMiMascotControl Width="48" Height="30"
                                              Expression="{Binding Indicator.Expression}"
                                              VerticalAlignment="Center"/>
                </Viewbox>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold"
                               Text="{Binding Indicator.Line}" ToolTip="{Binding Indicator.Line}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource AccentAmber}"
                               Text="{Binding Indicator.PendingLabel}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding Indicator.PendingLabel, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                           Foreground="{StaticResource TextTertiary}" Text="&#xE76C;"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentExpandedView}">
            <StackPanel Margin="20,14,20,12">
                <StackPanel Orientation="Horizontal">
                    <mascot:MiMiMascotControl Width="20" Height="14" Expression="{Binding Agent.Expression}"
                                              VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontPrimary}" FontWeight="SemiBold"
                               Margin="9,0,0,0" Text="{Binding Agent.Provider}"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                               Foreground="{StaticResource TextTertiary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.ProjectLabel}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Agent.ProjectLabel, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}" Margin="0,10,0,0"
                           VerticalAlignment="Top"
                           Text="{Binding Agent.Title}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}" Text="{Binding Agent.Message}"
                           TextWrapping="Wrap"
                           Visibility="{Binding Agent.Message, Converter={StaticResource StringToVis}}"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}" Margin="0,6,0,0"
                           Foreground="{StaticResource TextTertiary}" Text="{Binding Agent.SessionLabel}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.SessionLabel, Converter={StaticResource StringToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ApprovalView}">
            <StackPanel Margin="18,13,18,12">
                <StackPanel Orientation="Horizontal">
                    <mascot:MiMiMascotControl Width="22" Height="15" Expression="Alert"
                                              VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontPrimary}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAmber}" Margin="9,0,0,0"
                               Text="{Binding Agent.Title}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                               Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.Provider}"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextTertiary}" Margin="8,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.TimeLeft}"
                               Visibility="{Binding Agent.TimeLeft, Converter={StaticResource StringToVis}}"/>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource AccentAmber}" Margin="8,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Agent.ApprovalPosition}"/>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                                Visibility="{Binding Agent.HasMultipleApprovals, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource TransportButton}" Width="24" Height="24"
                                FontSize="{DynamicResource FontMicro}"
                                AutomationProperties.Name="Previous approval"
                                ToolTip="Previous approval"
                                Command="{Binding Agent.PrevApprovalCommand}" Content="&#xE76B;"/>
                        <Button Style="{StaticResource TransportButton}" Width="24" Height="24"
                                FontSize="{DynamicResource FontMicro}"
                                AutomationProperties.Name="Next approval"
                                ToolTip="Next approval"
                                Command="{Binding Agent.NextApprovalCommand}" Content="&#xE76C;"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="1,9,0,0"
                           Text="{Binding Agent.Message}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.Message, Converter={StaticResource StringToVis}}"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="1,0,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text="{Binding Agent.ProjectLabel}"
                           Visibility="{Binding Agent.ProjectLabel, Converter={StaticResource StringToVis}}"/>
                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" Margin="1,0,0,0"
                           Text="{Binding Agent.ActionLabel}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Agent.ActionLabel, Converter={StaticResource StringToVis}}"/>

                <Border Background="#1AFFFFFF" CornerRadius="7" Padding="10,6" Margin="1,8,0,0"
                        HorizontalAlignment="Left" MaxWidth="400"
                        Visibility="{Binding Agent.Command, Converter={StaticResource StringToVis}}">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                    <TextBlock Style="{StaticResource MonoFont}" Text="{Binding Agent.Command}" TextWrapping="Wrap"
                               ToolTip="{Binding Agent.Command}"
                               />
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="1,11,0,0">
                    <Button Style="{StaticResource ApproveButton}" Command="{Binding Agent.ApproveCommand}"
                            AutomationProperties.Name="Approve request"
                            ToolTip="Approve this request"
                            Content="{Binding Agent.ApproveLabel}"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Agent.DenyCommand}"
                            AutomationProperties.Name="Deny request"
                            ToolTip="Deny this request"
                            Content="Deny" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Agent.OpenCommand}"
                            AutomationProperties.Name="Copy session reference"
                            ToolTip="Copy a safe session reference to the clipboard"
                            Content="Copy session" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentActivityPanelView}">
            <Grid Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PanelHeading}" Text="Agent activity"/>
                        <TextBlock Style="{StaticResource PanelHint}" Text="{Binding Summary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource TransportButton}" Width="30" Height="30" Margin="0,0,6,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OpenQuickAccessCommand}"
                            Content="&#xE7C4;" ToolTip="Open Quick Access"/>
                    <Button Grid.Column="2" Style="{StaticResource TransportButton}" Width="30" Height="30"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseHoverCommand}"
                            Content="&#xE711;" ToolTip="Close agent activity"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource WidgetCard}" Margin="0,0,0,10" Padding="12,10"
                        Visibility="{Binding HasImpressiveBot, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse.Fill><SolidColorBrush Color="{Binding ImpressiveBotColor}"/></Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold" Text="{Binding ImpressiveBotLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                   Foreground="{StaticResource TextTertiary}" Margin="17,3,0,0"
                                   Text="{Binding ImpressiveBotDetail}" TextWrapping="Wrap"
                                   Visibility="{Binding ImpressiveBotDetail, Converter={StaticResource StringToVis}}"/>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                   Foreground="{StaticResource AccentAmber}" Margin="17,3,0,0"
                                   Text="{Binding ImpressiveBotApprovalNote}" TextWrapping="Wrap"
                                   Visibility="{Binding ImpressiveBotApprovalNote, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource IslandFont}" Text="{Binding Section}"
                                               FontSize="{DynamicResource FontMicro}" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentAmber}" Margin="2,0,0,5"
                                               Visibility="{Binding Section, Converter={StaticResource StringToVis}}"/>
                                    <Border Style="{StaticResource WidgetCard}" Padding="12,9" Margin="0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#33FFC266"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentGoldLight}"
                                                               Text="{Binding ProviderInitial}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"
                                                               Text="{Binding Provider}" ToolTip="{Binding Provider}"/>
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               Text="{Binding Project}" ToolTip="{Binding Project}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                                                               Text="{Binding StatusLabel}" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                                               Text="{Binding LastAction}"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                               Foreground="{StaticResource TextTertiary}" Text="{Binding AgeLabel}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="10"
                                                               Foreground="{StaticResource AccentAmber}" Text="{Binding PendingLabel}"
                                                               HorizontalAlignment="Right"
                                                               Visibility="{Binding PendingLabel, Converter={StaticResource StringToVis}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="4" Style="{StaticResource TransportButton}" Width="28" Height="28"
                                                        Command="{Binding CopySessionCommand}" IsEnabled="{Binding HasSessionId}"
                                                        Content="&#xE8C8;" ToolTip="Copy a safe session reference"
                                                        AutomationProperties.Name="Copy session reference"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Timeline}" Margin="40,7,0,0"
                                                          Visibility="{Binding Timeline.Count, Converter={StaticResource PendingToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource IslandFont}" FontSize="10"
                                                                       Foreground="{StaticResource TextTertiary}" Text="{Binding TimeLabel}"/>
                                                            <TextBlock Grid.Column="1" Style="{StaticResource IslandFont}" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondary}" Margin="7,0,0,0"
                                                                       Text="{Binding Text}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource PanelHint}" Margin="4,10,0,0"
                               Text="No agent sessions yet. Start a connected agent and its live status will appear here."
                               Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>


        <!-- ================= utility panels (Phase 4) ================= -->
        <DataTemplate DataType="{x:Type ui:PomodoroView}">
            <StackPanel Margin="16,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TransportButton}" Width="24" Height="24" Margin="0,0,8,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseUtilityCommand}"
                            ToolTip="Back to island">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE72B;"/>
                    </Button>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#22F5B84B">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource AccentAmber}" Text="&#xE823;"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}"
                                   FontWeight="SemiBold" Text="{Binding Pomodoro.PhaseLabel}"/>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}"
                                   Foreground="{StaticResource AccentAmber}"
                                   Text="{Binding Pomodoro.Remaining, StringFormat='{}{0} remaining'}"/>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                   Foreground="{StaticResource TextTertiary}" Text="{Binding Pomodoro.SubLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Width="30" Height="30"
                                Command="{Binding Pomodoro.PlayPauseCommand}" ToolTip="Start or pause focus timer">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Text="{Binding Pomodoro.Running, Converter={StaticResource RunningToGlyph}}"/>
                        </Button>
                        <Button Style="{StaticResource TransportButton}" Width="30" Height="30" Margin="8,0,0,0"
                                Command="{Binding Pomodoro.StopCommand}" ToolTip="Stop and reset focus timer">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Text="&#xE71A;"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Pomodoro.Progress, Mode=OneWay}"
                             Margin="0,8,0,0" Background="#2EFFFFFF" Foreground="{StaticResource AccentAmber}"
                             BorderThickness="0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:WaterView}">
            <StackPanel Margin="16,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TransportButton}" Width="24" Height="24" Margin="0,0,8,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseUtilityCommand}"
                            ToolTip="Back to island">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE72B;"/>
                    </Button>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#22F5B84B">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource AccentAmber}" Text="&#xE7C2;"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}"
                                   FontWeight="SemiBold" Text="Water today"/>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}"
                                   Foreground="{StaticResource AccentAmber}"
                                   Text="{Binding Water.TotalLabel}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource ApproveButton}" Padding="14,7"
                            Command="{Binding Water.QuickAddCommand}" ToolTip="Log a drink of water"
                            Content="{Binding Water.QuickAddLabel}"/>
                </Grid>
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Water.Progress, Mode=OneWay}"
                             Margin="0,8,0,0" Background="#2EFFFFFF" Foreground="{StaticResource AccentAmber}"
                             BorderThickness="0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:VolumeView}">
            <StackPanel Margin="18,12,18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource TransportButton}" Width="28" Height="28" Margin="0,0,10,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseUtilityCommand}"
                            ToolTip="Back to island">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE72B;"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PanelHeading}" Text="Volume"/>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                   Foreground="{StaticResource TextSecondary}" Text="{Binding Volume.StatusLabel}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource TransportButton}" Width="34" Height="34"
                            IsEnabled="{Binding Volume.IsAvailable}"
                            Command="{Binding Volume.MuteCommand}" ToolTip="Mute or unmute">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE74F;"/>
                    </Button>
                </Grid>
                <Slider Style="{StaticResource IslandSlider}" Margin="0,10,0,0"
                        Minimum="0" Maximum="100" Value="{Binding Volume.Level, Mode=TwoWay}"
                        AutomationProperties.Name="Master volume" ToolTip="Adjust master volume"
                        IsEnabled="{Binding Volume.IsAvailable}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:TodoView}">
            <StackPanel Margin="16,10,14,10">
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Width="22" Height="22" Margin="0,0,8,0"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseUtilityCommand}"
                                ToolTip="Back to island">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Text="&#xE72B;"/>
                        </Button>
                        <TextBlock Style="{StaticResource PanelHeading}" Text="Today’s tasks"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Right"
                               Text="{Binding Todo.HeaderCount}"/>
                </Grid>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AddTaskCommand}"
                        ToolTip="Open the task editor" Content="＋  Add a task…" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Todo.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Style="{StaticResource TransportButton}" Width="20" Height="20"
                                        Command="{Binding CompleteCommand}" ToolTip="Complete task">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Text="&#xE739;"/>
                                </Button>
                                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}"
                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                           Foreground="{StaticResource TextTertiary}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Text="{Binding DueLabel}"
                                           Visibility="{Binding DueLabel, Converter={StaticResource StringToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                           Text="You’re all caught up. Use “Add a task” to start your list."
                           Visibility="{Binding Todo.HasNoRows, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>


        <DataTemplate DataType="{x:Type ui:ShelfView}">
            <StackPanel Margin="16,10,14,10">
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Width="22" Height="22" Margin="0,0,8,0"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseUtilityCommand}"
                                ToolTip="Back to island">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Text="&#xE72B;"/>
                        </Button>
                        <TextBlock Style="{StaticResource PanelHeading}" Text="File shelf"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Right"
                               Text="{Binding HeaderCount}"/>
                </Grid>
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ShelfRow" Tag="{Binding Path}" Background="Transparent"
                                    Padding="2,3" Margin="0,0,0,2" Cursor="SizeAll"
                                    ToolTip="Drag out to Explorer or an app">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" Text="&#xE8B7;"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontBody}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" Width="200"/>
                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                               Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Text="{Binding SizeLabel}"/>
                                    <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                               Foreground="#FFFF8FB1" VerticalAlignment="Center"
                                               Text="{Binding MissingLabel}"/>
                                    <Button Style="{StaticResource TransportButton}" Width="20" Height="20"
                                            Margin="8,0,0,0" Command="{Binding RemoveCommand}"
                                            ToolTip="Remove from shelf (keeps the original file)">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                   Text="&#xE711;"/>
                                    </Button>
                                </StackPanel>
                            </Border>
