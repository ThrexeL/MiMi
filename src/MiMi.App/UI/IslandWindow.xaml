                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                    <TextBlock Style="{StaticResource MonoFont}" Text="{Binding Agent.Command}" TextWrapping="Wrap"
                               ToolTip="{Binding Agent.Command}"
                               />
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="1,11,0,0">
                    <Button Style="{StaticResource ApproveButton}" Command="{Binding Agent.ApproveCommand}"
                            AutomationProperties.Name="Approve request"
                            ToolTip="Approve this request"
                            Content="{Binding Agent.ApproveLabel}"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Agent.DenyCommand}"
                            AutomationProperties.Name="Deny request"
                            ToolTip="Deny this request"
                            Content="Deny" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Agent.OpenCommand}"
                            AutomationProperties.Name="Open in agent"
                            ToolTip="Copy a safe session reference to the clipboard"
                            Content="Copy session" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AgentActivityPanelView}">
            <!-- Fixed-height panel: the header and the ImpressiveBot line stay put and only
                 the session list scrolls, so the panel never resizes while it is open. -->
            <Grid Margin="20,14,20,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource PanelHeading}" Text="Agent activity"/>
                <TextBlock Grid.Row="1" Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                           Foreground="{StaticResource TextTertiary}" Text="{Binding Summary}" Margin="0,3,0,0"/>

                <!-- Live ImpressiveBot status: shown whenever ImpressiveBot reports, even with
                     no bot mid-turn. Approvals are still answered in ImpressiveBot. -->
                <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="8" Padding="10,7" Margin="0,9,0,0"
                        Visibility="{Binding HasImpressiveBot, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding ImpressiveBotColor}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                                       FontWeight="SemiBold" Text="{Binding ImpressiveBotLine}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                   Foreground="{StaticResource TextTertiary}" Margin="15,2,0,0"
                                   Text="{Binding ImpressiveBotDetail}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ImpressiveBotDetail}"
                                   Visibility="{Binding ImpressiveBotDetail, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource IslandFont}" Text="{Binding Section}" FontSize="{DynamicResource FontMicro}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTertiary}" Margin="0,6,0,7"
                                           Visibility="{Binding Section, Converter={StaticResource StringToVis}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding StateBrush.Color}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Width="118" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"
                                                   Text="{Binding Provider}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   Text="{Binding Project}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Width="150">
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontCaption}"
                                                   Text="{Binding StatusLabel}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"
                                                   Text="{Binding LastAction}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource TextTertiary}"
                                                   Text="{Binding AgeLabel}" HorizontalAlignment="Right"/>
                                        <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                   Foreground="{StaticResource AccentAmber}"
                                                   Text="{Binding PendingApprovals, StringFormat='{}{0} pending'}"
                                                   Visibility="{Binding PendingApprovals, Converter={StaticResource PendingToVis}}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Confirmed events only; bounded to three newest entries. -->
                                <ItemsControl ItemsSource="{Binding Timeline}" Margin="16,2,0,0"
                                              Visibility="{Binding Timeline.Count, Converter={StaticResource PendingToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                           Foreground="{StaticResource TextTertiary}"
                                                           Text="{Binding TimeLabel}" Width="38"/>
                                                <TextBlock Style="{StaticResource IslandFont}" FontSize="{DynamicResource FontMicro}"
                                                           Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0"
                                                           Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>


