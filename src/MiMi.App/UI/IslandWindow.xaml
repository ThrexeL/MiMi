                </ItemsControl>
                </ScrollViewer>
                <TextBlock Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHint}">
                            <Setter Property="Text" Value="Drag a file back out to use it. Originals stay untouched."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Text" Value="Your shelf is empty. Drop files onto this panel to keep them handy."/>
                                </DataTrigger>
