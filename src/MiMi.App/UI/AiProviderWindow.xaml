<Window x:Class="MiMi.App.UI.AiProviderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiMi · AI"
        Width="660" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#FF08090D" Foreground="#FFF3F3F5"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="Gold" Color="#FFFFC266"/>
        <Style x:Key="ProviderCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFC266"/>
            <Setter Property="Foreground" Value="#FF08090D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FFFFE2AE"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <TextBlock Text="AI assistants" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a detected assistant or configure your own."
                       Foreground="#99FFFFFF" Margin="0,4,0,0"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="#FFFF9F9F" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProviderItems" ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProviderCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="12" Background="#33FFC266" VerticalAlignment="Top">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                               Foreground="#FFFFE2AE" Text="{Binding Glyph}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#BFFFFFFF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#FFFFD79A" FontSize="12"
                                               HorizontalAlignment="Right" Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Open"
                                            Command="{Binding LaunchCommand}" IsEnabled="{Binding IsAvailable}"
                                            AutomationProperties.Name="{Binding Name}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DefaultButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Content="Launch default" HorizontalAlignment="Left" Click="DefaultButton_Click"/>
            <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Content="AI settings" Margin="8,0,0,0" Click="SettingsButton_Click"/>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Close" Margin="8,0,0,0" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
