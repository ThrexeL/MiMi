<UserControl x:Class="MiMi.App.UI.Mascot.MiMiMascotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="30"
             IsHitTestVisible="False"
             Focusable="False">

    <UserControl.Resources>
        <!-- Warm-white eyes with a soft gold bloom to match the island aurora. -->
        <RadialGradientBrush x:Key="MascotEyeBrush" Center="0.5,0.38"
                             RadiusX="0.5" RadiusY="0.6">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFFFFCF4" Offset="0.78"/>
            <GradientStop Color="#FFFFE6B8" Offset="1"/>
        </RadialGradientBrush>
        <DropShadowEffect x:Key="MascotEyeGlow" Color="#FFFFBE62" BlurRadius="5"
                          ShadowDepth="0" Opacity="0.62"/>
    </UserControl.Resources>

    <!-- Design space is 48x30; a Viewbox keeps the face proportional at any usage size.
         Two tall, softly glowing white eyes with balanced spacing echo Nusa's living
         notch. The wider gold aurora lives at island level. -->
    <!-- The dozing z's sit near the design box's top edge; the Viewbox keeps them
         inside it so the pill's rounded clip never cuts them off. -->
    <Viewbox Stretch="Uniform" ClipToBounds="False"
             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Width="48" Height="30" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="WakeScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <!-- Each eye is a group so the glow, core, blink, tilt, and glance all move
                 together. Centers at x=16/32, y=11 - balanced 16u spacing. -->
            <Canvas Width="48" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="EyeLGroup" Canvas.Left="4" Canvas.Top="-2" Width="24" Height="26"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeLMove"/>
                            <RotateTransform x:Name="EyeLTilt"/>
                            <ScaleTransform x:Name="EyeLBlink"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="EyeL" Width="10.5" Height="15.5"
                             Fill="{StaticResource MascotEyeBrush}" Effect="{StaticResource MascotEyeGlow}"/>
                </Grid>
                <Grid x:Name="EyeRGroup" Canvas.Left="20" Canvas.Top="-2" Width="24" Height="26"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeRMove"/>
                            <RotateTransform x:Name="EyeRTilt"/>
                            <ScaleTransform x:Name="EyeRBlink"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="EyeR" Width="10.5" Height="15.5"
                             Fill="{StaticResource MascotEyeBrush}" Effect="{StaticResource MascotEyeGlow}"/>
                </Grid>

            </Canvas>


            <!-- Cute accents: warm cheeks for happy/lively/curious, one sparkle for a
                 completed turn. They stay static unless motion is enabled. -->
            <Ellipse x:Name="CheekL" Width="5.5" Height="2.7" Fill="#88FFD08A" Opacity="0"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
            <Ellipse x:Name="CheekR" Width="5.5" Height="2.7" Fill="#88FFD08A" Opacity="0"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"/>
            <TextBlock x:Name="HappySparkle" Text="✦" FontFamily="Segoe UI Symbol" FontSize="9"
                       FontWeight="Bold" Foreground="#FFFFD79A" Opacity="0"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0"/>

            <!-- Dozing: two small z's drift up beside the face. The clock is gone in this
                 state, so the quiet space becomes part of the expression. -->
            <TextBlock x:Name="SleepZ1" Text="z" FontFamily="Segoe UI" FontSize="8.5"
                       FontWeight="Bold" Foreground="#E6F7C264" Opacity="0"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,2.5,0"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SleepZ1Move"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="SleepZ2" Text="z" FontFamily="Segoe UI" FontSize="5.5"
                       FontWeight="Bold" Foreground="#B8F7C264" Opacity="0"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1.5,0,0"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SleepZ2Move"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Viewbox>
</UserControl>
