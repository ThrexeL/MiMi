<UserControl x:Class="MiMi.App.UI.Mascot.MiMiMascotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="30"
             IsHitTestVisible="False"
             Focusable="False">

    <UserControl.Resources>
        <!-- Soft warm white with a faint vertical falloff so eyes read as lit, not painted. -->
        <LinearGradientBrush x:Key="MascotEyeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF8F0" Offset="0"/>
            <GradientStop Color="#F0F2E9DF" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- Design space is 48x30; a Viewbox keeps the face proportional at any usage size.
         The face: two perfectly round, evenly spaced eyes and (in relaxed states) a
         whisper of a smile. No glow lives here — MiMi's gold light belongs to the
         island's bottom edge, not to the face. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="48" Height="30" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="WakeScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <!-- Eyes: circles (1:1). They flatten only mid-blink and always return to
                 perfect circles. Centers at x=16/32, y=11 → balanced 16u spacing. -->
            <Canvas Width="48" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="EyeL" Width="7" Height="7" Fill="{StaticResource MascotEyeBrush}"
                         Canvas.Left="12.5" Canvas.Top="7.5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeLMove"/>
                            <RotateTransform x:Name="EyeLTilt"/>
                            <ScaleTransform x:Name="EyeLBlink"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeR" Width="7" Height="7" Fill="{StaticResource MascotEyeBrush}"
                         Canvas.Left="28.5" Canvas.Top="7.5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeRMove"/>
                            <RotateTransform x:Name="EyeRTilt"/>
                            <ScaleTransform x:Name="EyeRBlink"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Tiny curved smile: a shallow arc, only visible in relaxed states. -->
            <Path x:Name="Mouth" Width="7" Height="3" Stroke="#8AF5EDE2" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,11,0,0"
                  Data="M 0,0 Q 3.5,2.4 7,0"/>
        </Grid>
    </Viewbox>
</UserControl>
