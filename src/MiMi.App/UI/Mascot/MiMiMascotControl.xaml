<UserControl x:Class="MiMi.App.UI.Mascot.MiMiMascotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="30"
             IsHitTestVisible="False"
             Focusable="False">

    <UserControl.Resources>
        <!-- Bright white with the faintest warm edge, so the circles stay visually
             white while antialiasing gently into the dark surface. -->
        <RadialGradientBrush x:Key="MascotEyeBrush" Center="0.5,0.42"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFFDF8EE" Offset="0.82"/>
            <GradientStop Color="#F2F5EAD2" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <!-- Design space is 48x30; a Viewbox keeps the face proportional at any usage size.
         The face per the approved reference: two prominent bright-white ROUND eyes with
         balanced spacing — nothing else. The warm-gold light is a separate island-level
         aurora beneath the eyes (IslandWindow's GlowRoot), not part of this control. -->
    <Viewbox Stretch="Uniform"
             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Width="48" Height="30" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="WakeScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <!-- Each eye is a group so the glow, core, blink, tilt, and glance all move
                 together. Centers at x=16/32, y=11 - balanced 16u spacing. -->
            <Canvas Width="48" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="EyeLGroup" Canvas.Left="4" Canvas.Top="-2" Width="24" Height="26"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeLMove"/>
                            <RotateTransform x:Name="EyeLTilt"/>
                            <ScaleTransform x:Name="EyeLBlink"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="EyeL" Width="11" Height="11"
                             Fill="{StaticResource MascotEyeBrush}"/>
                </Grid>
                <Grid x:Name="EyeRGroup" Canvas.Left="20" Canvas.Top="-2" Width="24" Height="26"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyeRMove"/>
                            <RotateTransform x:Name="EyeRTilt"/>
                            <ScaleTransform x:Name="EyeRBlink"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="EyeR" Width="11" Height="11"
                             Fill="{StaticResource MascotEyeBrush}"/>
                </Grid>

            </Canvas>


            <!-- Dozing: two small z's drift up beside the face. The clock is gone in this
                 state, so the quiet space becomes part of the expression. -->
            <TextBlock x:Name="SleepZ1" Text="z" FontFamily="Segoe UI" FontSize="8.5"
                       FontWeight="Bold" Foreground="#E6F7C264" Opacity="0"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,2.5,0"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SleepZ1Move"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="SleepZ2" Text="z" FontFamily="Segoe UI" FontSize="5.5"
                       FontWeight="Bold" Foreground="#B8F7C264" Opacity="0"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1.5,0,0"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SleepZ2Move"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Viewbox>
</UserControl>
