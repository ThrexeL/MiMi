<Window x:Class="MiMi.App.UI.ApiConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiMi · AI API"
        Width="760" Height="580" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#FF08090D" Foreground="#FFF3F3F5"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <SolidColorBrush x:Key="Stroke" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="Gold" Color="#FFFFC266"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="#FF08090D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="ProviderTitle" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectionInfo" Foreground="#99FFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="AI settings" Click="Settings_Click" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#FFFFD79A" FontSize="12" TextWrapping="Wrap"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,12" Padding="8">
            <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TranscriptItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Bubble}" CornerRadius="12" Padding="12,9" Margin="0,0,0,9"
                                    HorizontalAlignment="{Binding Alignment}">
                                <StackPanel MaxWidth="590">
                                    <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFD79A"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PromptInput" AcceptsReturn="True" MinHeight="62" MaxHeight="120" TextWrapping="Wrap"
                     Background="#18FFFFFF" Foreground="#FFF3F3F5" BorderBrush="#33FFFFFF" BorderThickness="1"
                     CaretBrush="#FFFFC266" Padding="12,9" VerticalContentAlignment="Top" KeyDown="PromptInput_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource SendButton}" Content="Send"
                    MinWidth="88" Margin="10,0,0,0" VerticalAlignment="Bottom" Click="Send_Click"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Text only · no local files, tools, or command execution · Ctrl + Enter to send"
                       Foreground="#77FFFFFF" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="ClearButton" Grid.Column="1" Style="{StaticResource ActionButton}" Content="Clear chat" Click="Clear_Click"/>
        </Grid>
    </Grid>
</Window>
