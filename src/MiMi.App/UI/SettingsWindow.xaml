<Window x:Class="MiMi.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mascot="clr-namespace:MiMi.App.UI.Mascot"
        Title="MiMi Settings"
        Width="960" Height="760" MinWidth="680" MinHeight="520"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="#FF08090D"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True" FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="#FFF3F3F5" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#FFFFC266"/>
        <SolidColorBrush x:Key="GoldLight" Color="#FFFFE2AE"/>
        <SolidColorBrush x:Key="CardSurface" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="CardStroke" Color="#20FFFFFF"/>
        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFE2AE" Offset="0"/>
            <GradientStop Color="#FFFFC266" Offset="0.55"/>
            <GradientStop Color="#FFFF9257" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardSub" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="Margin" Value="0,3,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxMark" Width="19" Height="19" VerticalAlignment="Center"
                                        Background="#FF18191F" BorderBrush="#FF555762" BorderThickness="1" CornerRadius="5">
                                    <Grid>
                                        <Path x:Name="CheckGlyph" Data="M 3,8 L 7,12 L 14,4" Stroke="#FF08090D"
                                              StrokeThickness="2" Visibility="Collapsed"/>
                                        <Rectangle x:Name="MixedGlyph" Width="8" Height="2" Fill="#FFFFC266" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="CheckBoxMark" Property="BorderBrush" Value="#FFFFC266"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxMark" Property="Background" Value="{StaticResource GoldGradient}"/>
                                <Setter TargetName="CheckBoxMark" Property="BorderBrush" Value="#FFFFC266"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="MixedGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#FFFFC266"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFC266"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFFFC266"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#FF17181E"/>
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource GoldGradient}"/>
            <Setter Property="Foreground" Value="#FF08090D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="8,6,12,6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFC266"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="SliderSurface" MinHeight="28" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="6,0">
                            <Grid>
                            <Border Height="4" Background="#FF30323A" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"><Border Height="4" Background="{StaticResource GoldGradient}" VerticalAlignment="Center" CornerRadius="2"/></Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="SliderThumb" Background="#FFFFE2AE" BorderBrush="#FFFFC266" BorderThickness="1" CornerRadius="7"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="SliderThumb" Property="Background" Value="#FFFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderSurface" Property="BorderBrush" Value="#FFFFC266"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SliderSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="ValueChanged" Handler="Slider_ValueChanged"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Slider_MouseReleased"/>
            <EventSetter Event="LostKeyboardFocus" Handler="Slider_LostKeyboardFocus"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface" Background="#FF17181E" BorderBrush="#33FFFFFF"
                                    BorderThickness="1" CornerRadius="8"/>
                            <ContentPresenter Margin="12,8,34,8" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" Foreground="#FFFFC266" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                           IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#FF12131A" BorderBrush="#55FFC266" BorderThickness="1" CornerRadius="10"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="5">
                                    <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#FFFFC266"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="Background" Value="#FF202129"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FF08090D"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource GoldGradient}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFFFE2AE"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFFFC266"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#FF1B1B1F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Margin="2"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#44FFFFFF" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="24,18,24,24"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="SettingsRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SettingsHeader" Grid.Row="0" Padding="26,20,26,18" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="58" Height="40" CornerRadius="20" Background="#FFF3E7C8" VerticalAlignment="Center">
                    <mascot:MiMiMascotControl Width="50" Height="30" Expression="Lively" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="MiMi Settings"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" Text="A calmer, more personal control room for your island."/>
                </StackPanel>
                <Border Grid.Column="2" Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        CornerRadius="12" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" FontSize="12" FontWeight="SemiBold" Text="Changes save automatically"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Sub}" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="SettingsCategories" Grid.Row="1" TabStripPlacement="Top" Margin="24,14,24,0"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Settings categories">
            <TabItem Header="_General">
                <ScrollViewer x:Name="BodyScroll" Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="General"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Size, timing, modules, and the pages you want close at hand."/>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Island size and timing"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Tune the footprint and how quickly hover panels respond."/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Scale"/>
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.75" Maximum="1.5" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.05" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="ScaleLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Text size"/>
                                <ComboBox x:Name="TextSizeCombo" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="TextSize_Changed">
                                    <ComboBoxItem Content="Small"/><ComboBoxItem Content="Default"/><ComboBoxItem Content="Large"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Animation speed"/>
                                <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.1" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="SpeedLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Leave grace"/>
                                <Slider x:Name="DelaySlider" Grid.Column="1" Minimum="200" Maximum="5000" Value="900" IsSnapToTickEnabled="True" TickFrequency="50" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="DelayLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Idle auto-close"/>
                                <Slider x:Name="PanelIdleTimeoutSlider" Grid.Column="1" Minimum="0" Maximum="120" Value="30" IsSnapToTickEnabled="True" TickFrequency="5" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="PanelIdleTimeoutLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Sub}" Margin="170,0,0,0" Text="Hover panels close after this long without pointer movement. Set to Off to use only the leave grace."/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Interaction"/>
                            <CheckBox x:Name="ExpandOnHoverToggle" Style="{StaticResource Check}" Content="Expand music, agents, and the face on hover" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Quick Access pages"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Hide pages you do not use. The grid reflows automatically."/>
                            <UniformGrid Columns="3">
                                <CheckBox x:Name="PageFocusToggle" Style="{StaticResource Check}" Content="Focus" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageWaterToggle" Style="{StaticResource Check}" Content="Water" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageTodoToggle" Style="{StaticResource Check}" Content="To-do" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageShelfToggle" Style="{StaticResource Check}" Content="Shelf" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageVolumeToggle" Style="{StaticResource Check}" Content="Sound" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageBrightnessToggle" Style="{StaticResource Check}" Content="Brightness" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageClipboardToggle" Style="{StaticResource Check}" Content="Clipboard" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageWidgetsToggle" Style="{StaticResource Check}" Content="Widgets" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                                <CheckBox x:Name="PageAiToggle" Style="{StaticResource Check}" Content="AI" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            </UniformGrid>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Modules and lyrics"/>
                            <CheckBox x:Name="MediaToggle" Style="{StaticResource Check}" Content="Music module (Windows media sessions; restart required)" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="AgentsToggle" Style="{StaticResource Check}" Content="AI agent events" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="LyricsToggle" Style="{StaticResource Check}" Content="Synchronized lyrics in the expanded player" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="ClipboardHistoryToggle" Style="{StaticResource Check}" Content="Session-only clipboard history" ToolTip="Text stays in memory until MiMi exits, never on disk or in logs, and is limited to 20 clips." Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Lyrics sync offset"/>
                                <Slider x:Name="LyricsOffsetSlider" Grid.Column="1" Minimum="-10000" Maximum="10000" Value="0" IsSnapToTickEnabled="True" TickFrequency="100" SmallChange="100" LargeChange="1000" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="LyricsOffsetLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Sub}" Margin="170,0,0,0" Text="Positive values advance lyrics; negative values delay them."/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Appearance">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Warm gold light, a living face, and motion that respects your system."/>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Live mascot preview"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Try the expressions before they show up on your island."/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Height="104" CornerRadius="18" Background="#FF03040A" BorderBrush="#33FFC266" BorderThickness="1">
                                    <mascot:MiMiMascotControl x:Name="MascotPreview" Width="132" Height="76" Expression="Calm" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn}" Content="Calm" Click="PreviewExpression_Click" Tag="Calm" Margin="0,0,0,6"/>
                                    <Button x:Name="PreviewHappyButton" Style="{StaticResource Btn}" Content="Happy" Click="PreviewExpression_Click" Tag="Happy" Margin="0,0,0,6"/>
                                    <Button Style="{StaticResource Btn}" Content="Curious" Click="PreviewExpression_Click" Tag="Curious" Margin="0,0,0,6"/>
                                    <Button Style="{StaticResource Btn}" Content="Sleepy" Click="PreviewExpression_Click" Tag="Sleepy"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Face and glow"/>
                            <CheckBox x:Name="MascotToggle" Style="{StaticResource Check}" Content="Show the mascot face" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="GlowToggle" Style="{StaticResource Check}" Content="Gold aurora glow" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Glow intensity"/>
                                <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.6" IsSnapToTickEnabled="True" TickFrequency="0.05" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="GlowLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Animation intensity"/>
                                <Slider x:Name="FaceAnimSlider" Grid.Column="1" Minimum="0.5" Maximum="2" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.1" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="FaceAnimLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <CheckBox x:Name="MascotAnimationsToggle" Style="{StaticResource Check}" Content="Blinking, glances, and idle motion" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <CheckBox x:Name="MascotReactionsToggle" Style="{StaticResource Check}" Content="Reactions to agent starts and completions" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <CheckBox x:Name="MascotSleepyToggle" Style="{StaticResource Check}" Content="Doze after two quiet minutes" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Notifications">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Notifications"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Choose what deserves your attention and how long it stays."/>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Agent updates"/>
                            <CheckBox x:Name="AgentNotificationsToggle" Style="{StaticResource Check}" Content="Show agent notifications in MiMi" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <CheckBox x:Name="CompletionNotificationsToggle" Style="{StaticResource Check}" Content="Completion and failure notifications" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <CheckBox x:Name="ApprovalNotificationsToggle" Style="{StaticResource Check}" Content="Approval arrival notifications" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <CheckBox x:Name="WindowsNotificationsToggle" Style="{StaticResource Check}" Content="Windows notifications while MiMi is hidden" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Timing and sound"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Display duration"/>
                                <Slider x:Name="NotificationDurationSlider" Grid.Column="1" Minimum="1500" Maximum="10000" Value="3000" IsSnapToTickEnabled="True" TickFrequency="500" Thumb.DragCompleted="Slider_DragCompleted"/>
                                <TextBlock x:Name="NotificationDurationLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                            </Grid>
                            <CheckBox x:Name="NotificationSoundToggle" Style="{StaticResource Check}" Content="Notification sound" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Windows notifications respect Focus Assist. Approval notices open the request for review and never approve anything automatically."/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Integrations">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Integrations"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Local connections and provider health, without guessed trust."/>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Agent bridge"/>
                            <CheckBox x:Name="BridgeToggle" Style="{StaticResource Check}" Content="Local named-pipe listener (restart required)" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Sub}" Text="Provider diagnostics" VerticalAlignment="Center"/>
                                <Button x:Name="RefreshProvidersButton" Grid.Column="1" Style="{StaticResource Btn}" Content="Refresh" Click="RefreshProviders_Click"/>
                            </Grid>
                            <TextBlock x:Name="ProviderCheckedText" Style="{StaticResource Sub}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="AI assistants"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Codex and Claude are detected on PATH. Add any other AI CLI or app for this PC; nothing is hard-coded to one user."/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Default assistant"/>
                                <ComboBox x:Name="AiDefaultCombo" Grid.Column="1" SelectionChanged="AiSettings_Changed">
                                    <ComboBoxItem Content="Codex"/><ComboBoxItem Content="Claude"/><ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Custom name"/>
                                <TextBox x:Name="AiCustomNameInput" Grid.Column="1" Style="{StaticResource Input}" TextChanged="AiSettings_Changed"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Command or path"/>
                                <TextBox x:Name="AiCustomCommandInput" Grid.Column="1" Style="{StaticResource Input}" TextChanged="AiSettings_Changed"/>
                                <Button x:Name="BrowseAiCommandButton" Grid.Column="2" Style="{StaticResource Btn}" Content="Browse…" Margin="8,0,0,0" Click="BrowseAiCommand_Click"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Arguments"/>
                                <TextBox x:Name="AiCustomArgumentsInput" Grid.Column="1" Style="{StaticResource Input}" TextChanged="AiSettings_Changed"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AiAvailabilityText" Style="{StaticResource Sub}" Text="Checking installed assistants…" VerticalAlignment="Center"/>
                                <Button x:Name="RefreshAiButton" Grid.Column="1" Style="{StaticResource Btn}" Content="Refresh" Click="RefreshAiAvailability_Click"/>
                            </Grid>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Provider health"/>
                            <TextBlock x:Name="ClaudeProviderStatus" Style="{StaticResource Label}" Text="Claude Code — checking…"/>
                            <TextBlock x:Name="ClaudeProviderDetail" Style="{StaticResource Sub}" Margin="0,2,0,12"/>
                            <TextBlock x:Name="CodexProviderStatus" Style="{StaticResource Label}" Text="Codex — checking…"/>
                            <TextBlock x:Name="CodexProviderDetail" Style="{StaticResource Sub}" Margin="0,2,0,8"/>
                            <TextBlock x:Name="ProviderHintText" Style="{StaticResource Sub}" Text="Hook trust is verified by the provider, never guessed by MiMi."/>
                        </StackPanel></Border>

                        <Border x:Name="ImpressiveBotStatusPanel" Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Live team status"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse.Fill><SolidColorBrush Color="{Binding Accent}"/></Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Style="{StaticResource Label}" Text="{Binding Title}"/>
                                <TextBlock Style="{StaticResource Sub}" Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Sub}" Margin="18,5,0,0" Text="{Binding Detail}"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="18,2,0,0" Foreground="#70FFFFFF" Text="{Binding ApprovalNote}"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Try the integration"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Run a short local demo sequence to preview status, completion, and the mascot reaction."/>
                            <Button x:Name="RunDemoButton" Style="{StaticResource AccentButton}" Content="Run activity demo" Click="RunDemo_Click" HorizontalAlignment="Left"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Windows app notifications"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Reading other apps' notifications requires MSIX packaging and explicit user consent. The portable build intentionally reports this as unavailable rather than simulating it."/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_System">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="System"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Native HUDs, startup, visibility, and maintenance."/>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="System HUDs"/>
                            <CheckBox x:Name="VolumeHudToggle" Style="{StaticResource Check}" Content="Volume and mute" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="BatteryHudToggle" Style="{StaticResource Check}" Content="Charging and low battery" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="NetworkHudToggle" Style="{StaticResource Check}" Content="Network status" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="CapsLockHudToggle" Style="{StaticResource Check}" Content="Caps Lock and input language" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="HeadphoneHudToggle" Style="{StaticResource Check}" Content="Audio device changes" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <CheckBox x:Name="BrightnessHudToggle" Style="{StaticResource Check}" Content="Laptop brightness changes" Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
                            <TextBlock Style="{StaticResource CardSub}" Margin="0,8,0,0" Text="Brightness uses supported WMI laptop backlights only. External monitors are not controlled."/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Startup and desktop"/>
                            <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Check}" Content="Start with Windows" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                            <CheckBox x:Name="DesktopPersistToggle" Style="{StaticResource Check}" Content="Stay visible on the desktop (Win + D)" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <CheckBox x:Name="FullscreenToggle" Style="{StaticResource Check}" Content="Hide for fullscreen applications" Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
                            <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="While hidden, media and the agent bridge keep running. Approval requests still expire safely and are never approved automatically."/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Maintenance"/>
                            <TextBlock Style="{StaticResource CardSub}" Text="Open local diagnostics or restart MiMi after module changes."/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OpenLogsButton" Style="{StaticResource Btn}" Content="Open logs" Click="OpenLogs_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RestartButton" Style="{StaticResource Btn}" Content="Restart MiMi" Click="Restart_Click"/>
                            </StackPanel>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="SettingsFooter" Grid.Row="3" Background="#FF101116" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="24,12,24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SaveStatusText" Style="{StaticResource Sub}" Foreground="#FFFFC266"
                               AutomationProperties.LiveSetting="Polite" Text="Changes save automatically"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="10.5" Margin="0,2,0,0" Text="Stored locally in your MiMi app-data folder."/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Style="{StaticResource AccentButton}" Content="Done" Click="Close_Click" MinWidth="96"/>
            </Grid>
        </Border>
    </Grid>
</Window>
