<Window x:Class="MiMi.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiMi Settings"
        Width="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF141416"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The body scrolls and the footer stays pinned: the window can never grow past
         the screen again (it used to size to its content at ~1093 px on a 1080 px
         display, which pushed the title bar off-screen and clipped the bottom row). -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel Margin="22,18,18,10">
        <TextBlock Style="{StaticResource Label}" FontSize="17" FontWeight="SemiBold" Text="MiMi"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,14" TextWrapping="Wrap" Text="Dynamic Island for Windows 11 — local preferences, saved to %LOCALAPPDATA%\MiMi"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Scale"/>
            <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.75" Maximum="1.5" Value="1.0"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.05"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="ScaleLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Text size"/>
            <ComboBox x:Name="TextSizeCombo" Grid.Column="1" VerticalAlignment="Center"
                      Background="#1FFFFFFF" Foreground="#FFF2F2F4" BorderBrush="#22FFFFFF"
                      FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" Padding="7,3"
                      SelectionChanged="TextSize_Changed">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#FF1E1E20"/>
                        <Setter Property="Foreground" Value="#FFF2F2F4"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Small"/>
                <ComboBoxItem Content="Default"/>
                <ComboBoxItem Content="Large"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Animation speed"/>
            <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1.0"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.1"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="SpeedLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Collapse delay (ms)"/>
            <Slider x:Name="DelaySlider" Grid.Column="1" Minimum="250" Maximum="3000" Value="900"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="50"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="DelayLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Separator Background="#22FFFFFF" Margin="0,14,0,10"/>

        <CheckBox x:Name="MediaToggle" Style="{StaticResource Check}" Content="Music module (Windows media sessions; change needs restart)"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <CheckBox x:Name="AgentsToggle" Style="{StaticResource Check}" Content="AI agent events"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <CheckBox x:Name="MascotToggle" Style="{StaticResource Check}" Content="Mascot face"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <CheckBox x:Name="GlowToggle" Style="{StaticResource Check}" Content="Gold glow"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Glow intensity"/>
            <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.6"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.05"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="GlowLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Face animation"/>
            <Slider x:Name="FaceAnimSlider" Grid.Column="1" Minimum="0.5" Maximum="2" Value="1.0"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.1"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="FaceAnimLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>
        <CheckBox x:Name="BridgeToggle" Style="{StaticResource Check}" Content="Agent bridge (named pipe listener; change needs restart)"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>

        <CheckBox x:Name="MascotAnimationsToggle" Style="{StaticResource Check}" Content="Mascot blinking and idle motion"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="MascotReactionsToggle" Style="{StaticResource Check}" Content="Mascot reactions to agent events"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="MascotSleepyToggle" Style="{StaticResource Check}" Content="Doze after two quiet minutes (no agents, notices, or media)"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>

        <Separator Background="#22FFFFFF" Margin="0,12,0,8"/>

        <TextBlock Style="{StaticResource Sub}" Text="Notifications" Margin="0,0,0,4"/>
        <CheckBox x:Name="AgentNotificationsToggle" Style="{StaticResource Check}" Content="Show agent notifications in MiMi"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="CompletionNotificationsToggle" Style="{StaticResource Check}" Content="Completion and failure notifications"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="ApprovalNotificationsToggle" Style="{StaticResource Check}" Content="Approval notifications"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="WindowsNotificationsToggle" Style="{StaticResource Check}" Content="Windows notifications while MiMi is hidden"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="NotificationSoundToggle" Style="{StaticResource Check}" Content="Notification sound"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Notification duration"/>
            <Slider x:Name="NotificationDurationSlider" Grid.Column="1" Minimum="1500" Maximum="8000" Value="3000"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="500"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="NotificationDurationLabel" Grid.Column="2" Style="{StaticResource Sub}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="System notifications respect Focus Assist, never include commands or prompts, and never approve anything. Approval notices open the request for review."/>

        <Separator Background="#22FFFFFF" Margin="0,10,0,10"/>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Sub}" Text="Agent integrations" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProviderCheckedText" Grid.Column="1" Style="{StaticResource Sub}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Style="{StaticResource Btn}" Content="Refresh"
                    Click="RefreshProviders_Click" Padding="9,4"/>
        </Grid>
        <Separator Background="#22FFFFFF" Margin="0,10,0,10"/>

        <TextBlock Style="{StaticResource Sub}" Text="Windows app notifications" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="#90FFFFFF"
                   Text="Reading other apps' notifications requires MSIX packaging with the userNotificationListener capability plus explicit user consent. The portable build cannot access them, so this integration is intentionally unavailable rather than simulated."/>
        <!-- Live ImpressiveBot status. Display only: approvals are answered in ImpressiveBot. -->
        <StackPanel x:Name="ImpressiveBotStatusPanel" Margin="0,10,0,2">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding Accent}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Style="{StaticResource Label}" FontSize="13.5" Text="{Binding Title}"/>
                <TextBlock Style="{StaticResource Sub}" Text="{Binding Status}" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="16,2,0,0"
                       Text="{Binding Detail}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="16,1,0,0"
                       Foreground="#70FFFFFF" Text="{Binding ApprovalNote}"/>
        </StackPanel>
        <TextBlock x:Name="ClaudeProviderStatus" Style="{StaticResource Label}" FontSize="13.5"
                   Margin="0,7,0,0" Text="Claude Code — checking…"/>
        <TextBlock x:Name="ClaudeProviderDetail" Style="{StaticResource Sub}" TextWrapping="Wrap"
                   Margin="0,1,0,0"/>
        <TextBlock x:Name="CodexProviderStatus" Style="{StaticResource Label}" FontSize="13.5"
                   Margin="0,8,0,0" Text="Codex — checking…"/>
        <TextBlock x:Name="CodexProviderDetail" Style="{StaticResource Sub}" TextWrapping="Wrap"
                   Margin="0,1,0,0"/>
        <TextBlock x:Name="ProviderHintText" Style="{StaticResource Sub}" TextWrapping="Wrap"
                   Margin="0,4,0,0" Text="Hook trust is verified by the provider, never guessed by MiMi."/>

        <Separator Background="#22FFFFFF" Margin="0,10,0,10"/>

        <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Check}" Content="Start with Windows"
                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>

        <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,4" Text="Desktop behavior"/>
        <CheckBox x:Name="DesktopPersistToggle" Style="{StaticResource Check}" Content="Keep MiMi visible on the desktop (Win + D)"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="FullscreenToggle" Style="{StaticResource Check}" Content="Hide for fullscreen applications"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <TextBlock Style="{StaticResource Sub}" x:Name="HotkeyStatusText" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="While hidden, media monitoring and the agent bridge keep running. Approval requests still arrive and expire on schedule — they are never approved automatically. Press Ctrl + Alt + M to bring MiMi back."/>

    </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" Background="#FF18181A" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
              Padding="22,10,22,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn}" x:Name="OpenLogsButton" Content="Open log folder" Click="OpenLogs_Click"/>
            <Button Style="{StaticResource Btn}" x:Name="CloseButton" Content="Close" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
      </Border>
    </Grid>
</Window>
