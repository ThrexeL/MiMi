<Window x:Class="MiMi.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiMi Settings"
        Width="840" Height="700" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF141416"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="#FFF2F2F4" PreviewKeyDown="Window_PreviewKeyDown">


    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxMark" Width="18" Height="18" VerticalAlignment="Center"
                                        Background="#FF222226" BorderBrush="#FF777780" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Path x:Name="CheckGlyph" Data="M 3,8 L 7,12 L 14,4" Stroke="#FF171719"
                                              StrokeThickness="2" Visibility="Collapsed"/>
                                        <Rectangle x:Name="MixedGlyph" Width="8" Height="2" Fill="#FFE3BD72" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#FF252529"/>
                                <Setter TargetName="CheckBoxMark" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxMark" Property="Background" Value="#FFE3BD72"/>
                                <Setter TargetName="CheckBoxMark" Property="BorderBrush" Value="#FFE3BD72"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="MixedGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="8,8,12,8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Foreground" Value="#FFE3BD72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="SliderSurface" MinHeight="28" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="6,0">
                            <Grid>
                                <Border Height="4" Background="#FF414147" CornerRadius="2" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"><Border Height="4" Background="#FFB89451" VerticalAlignment="Center" CornerRadius="2"/></Border>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="18">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="SliderThumb" Background="#FFE3BD72" BorderBrush="#FFF7DFA9" BorderThickness="1" CornerRadius="7"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="SliderThumb" Property="Background" Value="#FFFFE6AF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderSurface" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SliderSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="ValueChanged" Handler="Slider_ValueChanged"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Slider_MouseReleased"/>
            <EventSetter Event="LostKeyboardFocus" Handler="Slider_LostKeyboardFocus"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface" Background="#FF252529" BorderBrush="#FF49494F"
                                    BorderThickness="1" CornerRadius="6"/>
                            <ContentPresenter Margin="10,7,28,7" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" Foreground="#FFE3BD72" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#FF1E1E20" BorderBrush="#FFE3BD72" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4">
                                    <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="Background" Value="#FF303034"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFB7B7BF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2,0,0,0" CornerRadius="0,8,8,0" Padding="14,14" Margin="0,3,8,3">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#FF252529"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFE3BD72"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="#FF302B22"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#FF1B1B1F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border x:Name="ScrollSurface" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" MinHeight="24" Margin="2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface" Background="#FF62626C" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#FFB89451"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#FFE3BD72"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/>
                                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/>
                                <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ScrollSurface" Property="BorderBrush" Value="#FFE3BD72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ScrollSurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="22,6,22,24"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
            <Setter Property="Foreground" Value="#FFE3BD72"/>
        </Style>
    </Window.Resources>

    <!-- Only category content scrolls; navigation and save feedback remain available. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Padding="24,18" BorderBrush="#FF303034" BorderThickness="0,0,0,1">
          <StackPanel>
              <TextBlock Style="{StaticResource Label}" FontSize="24" FontWeight="SemiBold" Text="MiMi Settings"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Make the island yours. Changes apply and save automatically; marked options require a restart."/>
          </StackPanel>
      </Border>
      <TabControl x:Name="SettingsCategories" Grid.Row="1" TabStripPlacement="Left" Margin="12,14,0,0"
                  Background="Transparent" BorderThickness="0" Padding="0"
                  KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Settings categories">
        <TabItem Header="_General">
          <ScrollViewer x:Name="BodyScroll" Style="{StaticResource PageScroll}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="General"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,22" Text="Size, timing, and the modules that appear in your island."/>
              <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,14" Text="Size and motion"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Scale"/>
            <Slider AutomationProperties.Name="Island scale" x:Name="ScaleSlider" Grid.Column="1" Minimum="0.75" Maximum="1.5" Value="1.0"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.05"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="ScaleLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Text size"/>
            <ComboBox AutomationProperties.Name="Island text size" x:Name="TextSizeCombo" Grid.Column="1" VerticalAlignment="Center"
                      Background="#1FFFFFFF" Foreground="#FFF2F2F4" BorderBrush="#22FFFFFF"
                      FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" Padding="7,3"
                      SelectionChanged="TextSize_Changed">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#FF1E1E20"/>
                        <Setter Property="Foreground" Value="#FFF2F2F4"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Small"/>
                <ComboBoxItem Content="Default"/>
                <ComboBoxItem Content="Large"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Animation speed"/>
            <Slider AutomationProperties.Name="Animation speed" x:Name="SpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1.0"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.1"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="SpeedLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Collapse delay (ms)"/>
            <Slider AutomationProperties.Name="Collapse delay in milliseconds" x:Name="DelaySlider" Grid.Column="1" Minimum="200" Maximum="5000" Value="900"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="50"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="DelayLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Separator Background="#22FFFFFF" Margin="0,14,0,10"/>

        <CheckBox x:Name="ExpandOnHoverToggle" Style="{StaticResource Check}" Content="Expand the island on hover"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,16,0,8" Text="Modules and lyrics"/>
        <CheckBox x:Name="MediaToggle" Style="{StaticResource Check}" Content="Music module (Windows media sessions; change needs restart)"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <CheckBox x:Name="AgentsToggle" Style="{StaticResource Check}" Content="AI agent events"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <CheckBox x:Name="LyricsToggle" Style="{StaticResource Check}" Content="Show synchronized lyrics in the expanded media panel"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Lyrics sync offset"/>
            <Slider x:Name="LyricsOffsetSlider" Grid.Column="1" Minimum="-10000" Maximum="10000" Value="0"
                    AutomationProperties.Name="Lyrics sync offset in milliseconds"
                    IsSnapToTickEnabled="True" TickFrequency="100" SmallChange="100" LargeChange="1000"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="LyricsOffsetLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                   Text="Offset in milliseconds (−10,000 to +10,000). Positive values advance lyrics; negative values delay them. Zero uses the original timing."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="_Appearance">
          <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="Appearance"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,22" Text="A little personality, with just the right amount of gold."/>
              <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,8" Text="Face and glow"/>
        <CheckBox x:Name="MascotToggle" Style="{StaticResource Check}" Content="Mascot face"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <CheckBox x:Name="GlowToggle" Style="{StaticResource Check}" Content="Gold glow"
                  Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Glow intensity"/>
            <Slider AutomationProperties.Name="Glow intensity" x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.6"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.05"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="GlowLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Face animation"/>
            <Slider AutomationProperties.Name="Face animation intensity" x:Name="FaceAnimSlider" Grid.Column="1" Minimum="0.5" Maximum="2" Value="1.0"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.1"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="FaceAnimLabel" Grid.Column="2" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
        </Grid>


        <CheckBox x:Name="MascotAnimationsToggle" Style="{StaticResource Check}" Content="Mascot blinking and idle motion"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="MascotReactionsToggle" Style="{StaticResource Check}" Content="Mascot reactions to agent events"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="MascotSleepyToggle" Style="{StaticResource Check}" Content="Doze after two quiet minutes (no agents, notices, or media)"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>

        <Separator Background="#22FFFFFF" Margin="0,12,0,8"/>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="_Notifications">
          <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="Notifications"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,22" Text="Choose which updates reach you and how long they stay."/>
              <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,8" Text="Agent updates"/>
        <CheckBox x:Name="AgentNotificationsToggle" Style="{StaticResource Check}" Content="Show agent notifications in MiMi"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="CompletionNotificationsToggle" Style="{StaticResource Check}" Content="Completion and failure notifications"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="ApprovalNotificationsToggle" Style="{StaticResource Check}" Content="Approval notifications"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="WindowsNotificationsToggle" Style="{StaticResource Check}" Content="Windows notifications while MiMi is hidden"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="NotificationSoundToggle" Style="{StaticResource Check}" Content="Notification sound"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Notification duration"/>
            <Slider AutomationProperties.Name="Notification duration in milliseconds" x:Name="NotificationDurationSlider" Grid.Column="1" Minimum="1500" Maximum="10000" Value="3000"
                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="500"
                    Thumb.DragCompleted="Slider_DragCompleted"/>
            <TextBlock x:Name="NotificationDurationLabel" Grid.Column="2" Style="{StaticResource Sub}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="System notifications respect Focus Assist, never include commands or prompts, and never approve anything. Approval notices open the request for review."/>

        <Separator Background="#22FFFFFF" Margin="0,10,0,10"/>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="_Integrations">
          <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="Integrations"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,16" Text="Local connections and provider health. MiMi never guesses provider trust."/>
              <CheckBox x:Name="BridgeToggle" Style="{StaticResource Check}" Content="Agent bridge (named pipe listener; change needs restart)"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
        <Grid Margin="0,16,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Sub}" Text="Agent integrations" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProviderCheckedText" Grid.Column="1" Style="{StaticResource Sub}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="RefreshProvidersButton" Grid.Column="2" Style="{StaticResource Btn}" Content="_Refresh"
                    Click="RefreshProviders_Click" Padding="9,4"/>
        </Grid>
        <Separator Background="#22FFFFFF" Margin="0,10,0,10"/>


        <!-- Live ImpressiveBot status. Display only: approvals are answered in ImpressiveBot. -->
        <StackPanel x:Name="ImpressiveBotStatusPanel" Margin="0,10,0,2">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding Accent}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Style="{StaticResource Label}" FontSize="13.5" Text="{Binding Title}"/>
                <TextBlock Style="{StaticResource Sub}" Text="{Binding Status}" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="16,2,0,0"
                       Text="{Binding Detail}"/>
            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="16,1,0,0"
                       Foreground="#70FFFFFF" Text="{Binding ApprovalNote}"/>
        </StackPanel>
        <TextBlock x:Name="ClaudeProviderStatus" Style="{StaticResource Label}" FontSize="13.5"
                   Margin="0,7,0,0" Text="Claude Code — checking…"/>
        <TextBlock x:Name="ClaudeProviderDetail" Style="{StaticResource Sub}" TextWrapping="Wrap"
                   Margin="0,1,0,0"/>
        <TextBlock x:Name="CodexProviderStatus" Style="{StaticResource Label}" FontSize="13.5"
                   Margin="0,8,0,0" Text="Codex — checking…"/>
        <TextBlock x:Name="CodexProviderDetail" Style="{StaticResource Sub}" TextWrapping="Wrap"
                   Margin="0,1,0,0"/>
        <TextBlock x:Name="ProviderHintText" Style="{StaticResource Sub}" TextWrapping="Wrap"
                   Margin="0,4,0,0" Text="Hook trust is verified by the provider, never guessed by MiMi."/>

        <Separator Background="#22FFFFFF" Margin="0,20,0,14"/>
        <TextBlock Style="{StaticResource Label}" Text="Windows app notifications" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Reading other apps' notifications requires MSIX packaging with the userNotificationListener capability plus explicit user consent. The portable build cannot access them, so this integration is intentionally unavailable rather than simulated."/>

        <Separator Background="#22FFFFFF" Margin="0,10,0,10"/>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="_System">
          <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="System"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,22" Text="System HUDs, startup, visibility, and your shortcut back to MiMi."/>
              <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,8" Text="System HUDs"/>
              <CheckBox x:Name="VolumeHudToggle" Style="{StaticResource Check}" Content="Show volume and mute HUD"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
              <CheckBox x:Name="BatteryHudToggle" Style="{StaticResource Check}" Content="Show charging and low-battery HUD"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
              <CheckBox x:Name="NetworkHudToggle" Style="{StaticResource Check}" Content="Show network status HUD"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
              <CheckBox x:Name="CapsLockHudToggle" Style="{StaticResource Check}" Content="Show Caps Lock and input language HUD"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
              <CheckBox x:Name="HeadphoneHudToggle" Style="{StaticResource Check}" Content="Show audio device change HUD"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
              <CheckBox x:Name="BrightnessHudToggle" Style="{StaticResource Check}" Content="Show brightness HUD"
                        Checked="Checkbox_Changed" Unchecked="Checkbox_Changed"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,20"
                         Text="Supported WMI laptop backlights only. External monitors and displays without WMI backlight support do not show a brightness HUD."/>
              <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,8" Text="Startup"/>
        <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Check}" Content="Start with Windows"
                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>

        <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,4" Text="Desktop behavior"/>
        <CheckBox x:Name="DesktopPersistToggle" Style="{StaticResource Check}" Content="Keep MiMi visible on the desktop (Win + D)"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <CheckBox x:Name="FullscreenToggle" Style="{StaticResource Check}" Content="Hide for fullscreen applications"
                  Checked="Checkbox_Changed2" Unchecked="Checkbox_Changed2"/>
        <TextBlock Style="{StaticResource Sub}" x:Name="HotkeyStatusText" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="While hidden, media monitoring and the agent bridge keep running. Approval requests still arrive and expire on schedule — they are never approved automatically. Press Ctrl + Alt + M to bring MiMi back."/>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" Background="#FF18181A" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
              Padding="22,10,22,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="SaveStatusText" Style="{StaticResource Sub}" Foreground="#FFE3BD72"
                       AutomationProperties.LiveSetting="Polite" Text="Changes save automatically"/>
            <TextBlock Style="{StaticResource Sub}" FontSize="10.5" Text="%LOCALAPPDATA%\MiMi\settings.json"/>
          </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn}" x:Name="OpenLogsButton" Content="Open _logs" Click="OpenLogs_Click"/>
            <Button Style="{StaticResource Btn}" x:Name="CloseButton" Content="_Close" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
        </Grid>
      </Border>
    </Grid>
</Window>
