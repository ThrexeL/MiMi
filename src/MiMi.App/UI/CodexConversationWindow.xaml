<Window x:Class="MiMi.App.UI.CodexConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MiMi.App.UI"
        Title="MiMi · Codex"
        Width="760" Height="580" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#18181B" Foreground="#F2F2F4"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="Foreground" Value="#F2F2F4"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFB454"/>
            <Setter Property="Foreground" Value="#1A1A1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Codex" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#A6FFFFFF" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="WorkspaceText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
        </Grid>

        <Border Grid.Row="1" Background="#101013" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12">
            <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TranscriptItems" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:CodexTranscriptRow}">
                            <Border Background="#1AFFFFFF" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFB454"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Foreground="#E6E6EA"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#8F8F96" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBox Grid.Row="2" x:Name="PromptInput" Height="74" Margin="0,12,0,0" Padding="10,8"
                 Background="#202024" Foreground="#F2F2F4" BorderBrush="#33FFFFFF" BorderThickness="1"
                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                 KeyDown="PromptInput_KeyDown"
                 VerticalContentAlignment="Top" ToolTip="Message Codex. Enter sends; Shift+Enter adds a line."/>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="PrivacyText" Text="Experimental · in-memory only · approvals are one-request"
                       Foreground="#8F8F96" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/>
                <Button x:Name="SendButton" Content="Send" Click="Send_Click" Style="{StaticResource SendButton}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
